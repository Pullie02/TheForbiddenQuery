[sub_resource type="GDScript" id="GDScript_441x5"]
script/source = "extends Node2D

@onready var interactable: Area2D = $Interactable

func _ready():
	interactable.interact = _on_interact
	
func _on_interact():
	get_tree().change_scene_to_file(\"res://scenes/lvls/lvl2/level_2.tscn\")
"

